{{- $hasPwsh  := lookPath "pwsh" -}}
{{- $hasMsys2 := stat "C:/msys64/usr/bin/bash.exe" -}}
{{- $hasVS    := stat "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe" -}}
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "keybindings":
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        }
    ],
    "newTabMenu":
    [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles":
    {
        "defaults":
        {
            "colorScheme": "Dark One Nuanced",
            "font":
            {
                "face": "JetBrainsMono Nerd Font Mono"
            }
        },
        "list":
        [
            {
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": true,
                "name": "Windows PowerShell"
            },
            {
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "hidden": true,
                "name": "Command Prompt"
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "hidden": true,
                "name": "Azure Cloud Shell",
                "source": "Windows.Terminal.Azure"
            }
            {{- if $hasPwsh }},
            {
                "commandline": "\"%LOCALAPPDATA%\\Microsoft\\WindowsApps\\pwsh.exe\"",
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore"
            }
            {{- end }}
            {{- if $hasMsys2 }},
            {
                "commandline": "C:\\msys64\\usr\\bin\\bash.exe --login -i",
                "guid": "{17da3cac-b318-431e-8a3e-7fcdefe6d114}",
                "hidden": false,
                "icon": "C:\\msys64\\msys2.ico",
                "name": "MSYS2",
                "startingDirectory": "C:\\msys64\\home\\%USERNAME%"
            }
            {{- end }}
            {{- if $hasVS }},
            {
                "guid": "{a75dd6c2-cd4f-57ad-a28f-a80bb57d0701}",
                "hidden": true,
                "name": "Developer Command Prompt for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            },
            {
                "guid": "{88c8bb65-726e-5dcf-88cd-cbd25079da76}",
                "hidden": true,
                "name": "Developer PowerShell for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            }
            {{- end }}
            {{- if $hasPwsh }},
            {
                "guid": "{5fb123f1-af88-5b5c-8953-d14a8def1978}",
                "hidden": false,
                "name": "PowerShell 7",
                "source": "Windows.Terminal.PowershellCore"
            }
            {{- end }}
            {{- if $hasVS }},
            {
                "guid": "{f4458fbf-17f0-5537-9aac-a5d471bfa375}",
                "hidden": false,
                "name": "Developer Command Prompt for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            },
            {
                "guid": "{a1dabbd0-901f-5a34-9475-5b28eaefc2e7}",
                "hidden": false,
                "name": "Developer PowerShell for VS 2022",
                "source": "Windows.Terminal.VisualStudio"
            }
            {{- end }}
        ]
    },
    "schemes":
    [
        {
            "background": "#282C34",
            "black": "#3F4451",
            "blue": "#61AFEF",
            "brightBlack": "#4F5666",
            "brightBlue": "#67CDFF",
            "brightCyan": "#63D4E0",
            "brightGreen": "#B1E18B",
            "brightPurple": "#E48BFF",
            "brightRed": "#FF7B86",
            "brightWhite": "#FFFFFF",
            "brightYellow": "#EFB074",
            "cursorColor": "#ABB2BF",
            "cyan": "#56B6C2",
            "foreground": "#ABB2BF",
            "green": "#98C379",
            "name": "Dark One Nuanced",
            "purple": "#C678DD",
            "red": "#E06C75",
            "selectionBackground": "#3F4451",
            "white": "#E6E6E6",
            "yellow": "#D19A66"
        }
    ],
    "themes": []
}
